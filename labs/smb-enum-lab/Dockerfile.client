FROM ubuntu:22.04

# Cài tools pentest + dependencies ttyd
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    smbclient \
    nmap \
    openssh-client \
    vim \
    nano \
    sudo \
    net-tools \
    iputils-ping \
    wget \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    git \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Install ttyd
RUN wget -O /usr/local/bin/ttyd \
    https://github.com/tsl0922/ttyd/releases/latest/download/ttyd.x86_64 && \
    chmod +x /usr/local/bin/ttyd

# Cài enum4linux
RUN git clone https://github.com/CiscoCXSecurity/enum4linux.git /tmp/enum4linux && \
    cp /tmp/enum4linux/enum4linux.pl /usr/local/bin/enum4linux && \
    chmod +x /usr/local/bin/enum4linux && \
    rm -rf /tmp/enum4linux

# Cài impacket
RUN pip3 install --no-cache-dir impacket || true

# Tạo user
RUN useradd -m -s /bin/bash admin && \
    echo 'admin:admin123' | chpasswd && \
    usermod -aG sudo admin

WORKDIR /home/admin

# Banner
COPY banner.sh /home/admin/banner.sh
RUN chmod +x /home/admin/banner.sh

RUN echo "" >> /home/admin/.bashrc && \
    echo "if [ -f /home/admin/banner.sh ]; then /home/admin/banner.sh; fi" >> /home/admin/.bashrc

# Entrypoint
COPY entrypoint-client.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN chown -R admin:admin /home/admin

USER admin

ENTRYPOINT ["/entrypoint.sh"]

FROM ubuntu:22.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    hydra \
    nmap \
    openssh-client \
    vim \
    nano \
    sudo \
    net-tools \
    iputils-ping \
    wget \
    gzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/share/wordlists

RUN useradd -m -s /bin/bash admin && \
    echo 'admin:admin123' | chpasswd && \
    usermod -aG sudo admin

WORKDIR /home/admin

COPY banner.sh /home/admin/banner.sh
RUN chmod +x /home/admin/banner.sh

RUN echo "" >> /home/admin/.bashrc && \
    echo "# Display banner on login" >> /home/admin/.bashrc && \
    echo "if [ -f /home/admin/banner.sh ]; then" >> /home/admin/.bashrc && \
    echo "    /home/admin/banner.sh" >> /home/admin/.bashrc && \
    echo "fi" >> /home/admin/.bashrc

RUN chown -R admin:admin /home/admin

USER admin

CMD ["/bin/bash"]